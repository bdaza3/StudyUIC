# Server-only configuration. Do not add any of these values to NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
EMBEDDING_MODEL=text-embedding-3-small

# Include every local and deployed frontend origin, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-frontend.example.com
